{
  "name": "sunshade-maps",
  "private": true,
  "description": "maps.sunshade.icu — Civic Field Guide & Spatial Intelligence Engine monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sunshade/maps-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present --"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
