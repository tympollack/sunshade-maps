# Copy to .env.local. Never commit real values.

# Supabase project (shared SunShade platform). Public anon key only — never a service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hub origin for SSO sign-in hand-off. Non-production: https://hub-stag.sunshade.icu
NEXT_PUBLIC_HUB_URL=https://hub.sunshade.icu

# Optional basemap overrides (defaults: keyless OpenFreeMap).
# NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
# NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
