{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build --workspace=@sunshade/maps-web",
  "outputDirectory": "apps/maps-web/.next",
  "headers": [
    {
      "source": "/maplibre/(.*\\.mjs)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    }
  ]
}
